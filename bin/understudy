KNOWN_NAME_CATEGORY = {n: cat for cat, names in KNOWN_NAMES.items() for n in names.split()}
NAME_PATTERNS = [
    (r"^(ttf|otf|woff2?)-|^noto-fonts|-fonts?(-git)?$|-icon-theme$|-cursors?(-theme)?$|-gtk-theme$", "Themes/Look"),
    (r"^(lib32-)?(wine|proton|dxvk|vkd3d)(-|$)", "Gaming"),
    (r"^(python|ruby|perl|rust|go|haskell|nodejs|mingw-w64)-|-sdk$", "Dev"),
]
# Omarchy installers are named for what they set up.
INSTALLER_PATTERNS = [
    (r"^omarchy-install-gaming-", "Gaming"),
    (r"^omarchy-install-(dev-|editor-|ai-|docker-)", "Dev"),
    (r"^omarchy-install-terminal$", "CLI/TUI"),
    (r"^omarchy-install-(browser|chromium-|service-(signal|tailscale|dropbox|nordvpn))", "Internet/Communication"),
    (r"^omarchy-install-service-(spotify|sunshine)", "Media"),
    (r"^omarchy-install-font", "Themes/Look"),
    (r"^omarchy-install-service-1password", "System/Hardware"),
]
# .desktop Categories, the first that matches deciding.
DESKTOP_CATEGORIES = [
    ({"Game"}, "Gaming"),
    ({"Development", "IDE"}, "Dev"),
    ({"TerminalEmulator"}, "CLI/TUI"),
    ({"Office"}, "Office"),
    ({"AudioVideo", "Audio", "Video", "Graphics"}, "Media"),
    ({"Network", "Chat", "Email", "WebBrowser", "InstantMessaging"}, "Internet/Communication"),
    ({"System", "Settings", "HardwareSettings"}, "System/Hardware"),
