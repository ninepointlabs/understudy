MENU_BEGIN = "  // >>> understudy — managed by `understudy setup omarchy`, do not edit between the markers"
MENU_END = "  // <<< understudy"
DATA_DIRS = [Path(d) for d in (os.environ.get("XDG_DATA_DIRS") or "/usr/local/share:/usr/share").split(":") if d]
FLATPAK_SYSTEM = Path(os.environ.get("FLATPAK_SYSTEM_DIR") or "/var/lib/flatpak")
THEMES_DIR = HOME / ".config/omarchy/themes"
