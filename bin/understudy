KEYWORD_CATEGORIES = [
    (r"\b(game|games|gaming|emulator|proton|steam|warcraft|wow)\b", "Gaming"),
    (r"\b(ide|compiler|programming|debugger|sdk|toolchain|language server|development|developer)\b", "Dev"),
    (r"\b(office|document|spreadsheet|word processor|pdf|notes?|e-?book|reader)\b", "Office"),
