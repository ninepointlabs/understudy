GROUP_CATEGORIES = [
    (r"^base-devel$|^qt\d|^kf\d", "Dev"),
    (r"^(pro-audio|gstreamer)", "Media"),
    (r"^(xorg-drivers|lib32-)", "System/Hardware"),
