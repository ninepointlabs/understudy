    "network": "Internet/Communication", "system": "System/Hardware", "hardware": "System/Hardware",
    "themes": "Themes/Look", "theme": "Themes/Look", "look": "Themes/Look",
}

# Known names win over anything a package says about itself.
KNOWN_NAMES = {
